rules_version = '2';

// 접근 제어 방식
// - 구글 로그인은 아무 구글 계정이나 가능하지만, "허용된 이메일 목록(allowlist 컬렉션)"에
//   등록된 이메일만 실제로 논문/댓글 데이터를 읽고 쓸 수 있다.
// - allowlist 자체를 추가/삭제할 수 있는 사람은 관리자(ADMIN_EMAILS)뿐이다.
//
// !!! ADMIN_EMAILS 배열은 firebase-config.js 에도 똑같이 있어야 한다 !!!
// (firebase-config.js 쪽은 화면에 "직원 관리" 탭을 보여줄지만 결정하고,
//  진짜 권한은 여기 아래 이메일 목록이 결정한다. 관리자를 바꾸거나 추가하려면
//  이 파일과 firebase-config.js 둘 다 고치고 Firestore 규칙을 다시 게시해야 한다.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'changhee2505@gmail.com'
        ];
    }

    function isAllowed() {
      return request.auth != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email))
      );
    }

    // 허용된 직원 이메일 목록
    match /allowlist/{email} {
      // 본인 이메일 문서는 스스로 조회 가능(로그인 직후 "나는 허용됐나?" 확인용)
      allow get: if request.auth != null &&
        (isAdmin() || request.auth.token.email == email);
      // 전체 목록 조회/추가/삭제는 관리자만
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 내부 도구 HTML (건강검진 결과지 등). GitHub Actions(Admin SDK)만 쓸 수 있고,
    // 로그인+허용된 직원만 읽을 수 있다.
    match /tools/{toolId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // 스터디 논문 (PMID 수동 등록). 본문 쓰기는 GitHub Actions(Admin SDK)만,
    // 읽기와 리뷰(댓글)는 허용된 직원만.
    match /study_papers/{paperId} {
      allow read: if isAllowed();
      // 논문 추가/수정은 GitHub Actions(Admin SDK)만. 삭제는 관리자(원장)만 사이트에서 가능.
      allow create, update: if false;
      allow delete: if isAdmin();
      match /comments/{commentId} {
        allow read: if isAllowed();
        allow create: if isAllowed()
                       && request.resource.data.keys().hasAll(['name', 'text', 'created_at'])
                       && request.resource.data.text is string
                       && request.resource.data.text.size() > 0
                       && request.resource.data.text.size() < 2000;
        allow update, delete: if false;
      }
      // 한줄 요약(논문당 1개). 허용된 직원 누구나 작성/수정 가능.
      match /meta/summary {
        allow read: if isAllowed();
        allow write: if isAllowed()
                       && request.resource.data.text is string
                       && request.resource.data.text.size() < 1000;
      }
    }
    // 응급 프로토콜. 허용된 직원 누구나 추가/수정/삭제할 수 있다.
    match /protocols/{protocolId} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
                       && request.resource.data.keys().hasAll(['title', 'body', 'updated_at', 'updated_by'])
                       && request.resource.data.title is string
                       && request.resource.data.title.size() > 0
                       && request.resource.data.title.size() < 200
                       && request.resource.data.body is string
                       && request.resource.data.body.size() > 0
                       && request.resource.data.body.size() < 20000;
      allow delete: if isAllowed();
    }
    match /papers/{paperId} {
      allow read: if isAllowed();
      // 논문 추가/수정은 GitHub Actions(서비스 계정, Admin SDK)만. 삭제는 관리자(원장)만 사이트에서 가능.
      allow create, update: if false;
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isAllowed();
        allow create: if isAllowed()
                       && request.resource.data.keys().hasAll(['name', 'text', 'created_at'])
                       && request.resource.data.text is string
                       && request.resource.data.text.size() > 0
                       && request.resource.data.text.size() < 2000;
        allow update, delete: if false;
      }
      // 한줄 요약(논문당 1개). 허용된 직원 누구나 작성/수정 가능.
      match /meta/summary {
        allow read: if isAllowed();
        allow write: if isAllowed()
                       && request.resource.data.text is string
                       && request.resource.data.text.size() < 1000;
      }
    }
  }
}
